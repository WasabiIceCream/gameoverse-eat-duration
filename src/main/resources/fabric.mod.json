    ],
    "client": [
      "net.gameoverse.eatduration.EatDurationClient"
    ]
  },
  "mixins": [
    "gameoverse_eat_duration.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
